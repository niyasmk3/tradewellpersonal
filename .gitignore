# Runtime state — per-machine, regenerated on start. .trades.json and
# .signals.json hold real trading activity; .instruments_cache.json is a ~13MB
# daily dump. None of it belongs in version control.
.trades.json
.trades.json.corrupt
.signals.json
.signals.backup-*.json
.signals_archive.jsonl
.shadow_signals_archive.jsonl
.daily_ops.json
.hollow_signals.json
.late_signals.json
.refire_signals.json
.setup_signals.json
.confirm_signals.json
.level_alerts.json
.eval_trace.jsonl
.news_seen.json
.instruments_cache.json
.patterns_candles.db
.patterns_results.json
.condor_signals.json
.condor_positions.json
.condor_archive.jsonl
.condor_eval.jsonl
.condor_chain.db
# SQLite WAL-mode sidecars (the snapshot logger runs PRAGMA journal_mode=WAL)
.condor_chain.db-shm
.condor_chain.db-wal

# Closing Day Strategy module (app/closing): India VIX bar store + results
.closing_vix.db
.closing_results.json
.closing_tonight.jsonl
.closing_snapshot.jsonl
.closing_snapshot_stamps.json
.closing_exit_quotes.jsonl
.overnight_results.json
# Gold module (app/gold): MCX + XAUUSD candle stores + results
.gold_candles.db
.gold_xau.db
.gold_results.json

# Reconstructed Tickertape MMI daily series (2012->present; Wayback + a public
# 2012-2024 dataset, cross-validated). Regenerable but expensive (~1h of
# rate-limited archive scraping) — keep the file, not the wait. The joined
# study output is cheap to regenerate (scripts/mmi_overnight_study.py) and
# is derived data, so it stays out of the repo like every other run product.
.mmi_daily.csv
.mmi_joined.json

