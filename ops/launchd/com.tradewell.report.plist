<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradewell.report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/niyas/Developer/Tradewell/recorder/evening_report.sh</string>
    </array>
    <!-- TZ-proof: fire every 5 min; evening_report.sh gates itself to
         16:00-16:14 IST once per weekday (SCHEDULED=1). -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>EnvironmentVariables</key>
    <dict><key>SCHEDULED</key><string>1</string></dict>
    <key>StandardOutPath</key>
    <string>/Users/niyas/Developer/Tradewell/recorder/data/report-job.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/niyas/Developer/Tradewell/recorder/data/report-job.log</string>
</dict>
</plist>
