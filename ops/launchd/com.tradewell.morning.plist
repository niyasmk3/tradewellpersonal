<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradewell.morning</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/niyas/Developer/Tradewell/recorder/morning_reset.sh</string>
    </array>
    <!-- TZ-proof: fire every 5 min; morning_reset.sh gates itself to
         08:40-08:59 IST once per weekday (SCHEDULED=1). Calendar triggers
         followed the Mac's local clock and drifted to 10:10 IST on Dubai time. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>EnvironmentVariables</key>
    <dict><key>SCHEDULED</key><string>1</string></dict>
    <key>StandardOutPath</key>
    <string>/Users/niyas/Developer/Tradewell/recorder/data/morning_reset.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/niyas/Developer/Tradewell/recorder/data/morning_reset.log</string>
</dict>
</plist>
