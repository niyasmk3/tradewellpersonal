<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tradewell login auto-start (template).

  Installed by `./start.sh install-launchd`, which bakes the checkout path in
  and copies this to ~/Library/LaunchAgents/com.tradewell.stack.plist WITHOUT
  loading it — enabling auto-start is your call, made once:

      launchctl load ~/Library/LaunchAgents/com.tradewell.stack.plist

  CAVEAT: RunAtLoad means that command starts the stack IMMEDIATELY (killing
  whatever holds the ports), not just at the next login — run it after 15:30
  IST like any other deploy.

  It runs start.sh with -\-live-override on purpose: at login nothing is
  running, so bringing the stack up is crash recovery, exactly what the
  override exists for. The market-hours guard still protects every MANUAL
  restart. No KeepAlive — if you stop the stack, launchd must not fight you.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradewell.stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TRADEWELL_ROOT__/start.sh</string>
    <string>--live-override</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__TRADEWELL_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__TRADEWELL_ROOT__/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__TRADEWELL_ROOT__/logs/launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's PATH lacks Homebrew; node/npm live there on this machine. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
