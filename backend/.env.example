# ---- Kite Connect credentials ----
# From https://developers.kite.trade/apps (your active Connect app)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Access token is obtained daily via the login flow (POST /auth/session).
# It expires every morning (~7:30 AM IST), so you re-login each trading day.
# Once you have it you may paste it here to skip the browser step on restart.
KITE_ACCESS_TOKEN=

# ---- App config ----
# Underlyings to track in Phase 1 (comma-separated). Supported: NIFTY, BANKNIFTY, FINNIFTY
TRACK_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY

# How many strikes above/below ATM to build into the option chain
OPTION_CHAIN_DEPTH=10

# Option-chain refresh interval in seconds (Kite quote polling)
OPTION_POLL_SECONDS=5

# How often (seconds) the server broadcasts live state to browser clients
BROADCAST_SECONDS=1

# CORS origin for the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# ---- Phase 4: News intelligence (optional) ----
# Anthropic API key for Claude-powered news sentiment. Without it, news analysis
# is off and the news score stays neutral (everything else works).
ANTHROPIC_API_KEY=
# Model for classification. Opus is the default; claude-haiku-4-5 is cheaper for
# high-volume classification.
NEWS_MODEL=claude-opus-4-8
NEWS_ENABLED=true

# ---- Off-desk signal alerts (optional) ----
# The browser chime only fires with the dashboard tab open, so a signal issued
# while you are away is a signal you never see. Point this at a push endpoint and
# the backend posts each newly issued card to it. Empty = disabled, no network
# call is ever made.
#   ntfy:     https://ntfy.sh/pick-a-long-private-topic-name
#   Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat_id>
ALERT_WEBHOOK_URL=
# SIGNALS-ONLY second webhook, for sharing cards with another person without
# handing over the master topic above. This topic receives signal cards and
# card retirements ONLY — never watchdog pages, invalidation nags, or armed
# confirmations (those describe your positions and your infrastructure) —
# and shared cards omit the suggested-lots line, which is derived from
# YOUR trading capital.
# Give the other person just this topic; revoke by rotating just this topic.
# NOTE: distributing signals others trade on can trip SEBI RA/IA rules —
# personal-use status assumes the signals reach only you.
ALERT_WEBHOOK_URL_2=
# "text" posts a plain body (ntfy); "json" posts {title,text,message,score,...}
# which is what Telegram, Slack and Discord webhooks expect.
ALERT_WEBHOOK_FORMAT=text
# Only push cards at or above this score. 0 = every issued card (recommended:
# the throttle already caps the engine at 4 cards/day).
ALERT_MIN_SCORE=0
# Dead-feed watchdog: page the webhook when no tick has arrived for this many
# seconds during market hours (re-pages every 10 min while silent, all-clear on
# recovery). The 23-Jul blackout hid the day's whole move — never again silently.
# 0 disables.
FEED_WATCHDOG_AGE_S=150

# Thesis-stall time stop (intraday only): after this many minutes without the
# quick target being touched, the monitor recommends exit — a late thesis in a
# bought option is theta bleed. Paper auto-closes on it (evidence gathering);
# the live journal only auto-closes if you add "stall" to AUTO_CLOSE_TRIGGERS.
# 0 disables.
STALL_EXIT_MINUTES=45

# Which plan triggers auto-close JOURNAL rows (bookkeeping only, no orders).
# Subset of: stop, target1, target2, invalidation, time_exit, stall, quick_bank.
# AUTO_CLOSE_TRIGGERS=stop,target1,invalidation

# ---- Position sizing (optional) ----
# Two different questions, two different knobs:
#   TRADING_CAPITAL — "how much may I LOSE per trade": drives the risk-based
#       suggested_lots via RISK_PER_TRADE_PCT. 0 = no suggestion shown.
#   TRADING_FUND    — "how many lots can my money BUY at this premium": the
#       day's deployable premium budget. Each card prefills
#       lots = fund ÷ (premium × lot size), so the Kite basket opens with the
#       right quantity. Editable live from the dashboard (risk-limits panel);
#       this value is only the baseline. 0 = feature off.
#       e.g. 1000000 at a ₹100 premium (lot 65) prefills 153 lots = 9,945 qty.
TRADING_CAPITAL=0
TRADING_FUND=0

# A signal card may only be issued on a premium quote at most this old
# (seconds). Protects against stale chain/tick prices publishing entry zones
# that no longer exist — observed lags ranged from 3 minutes to a full day.
# 0 disables the gate.
SIGNAL_MAX_PREMIUM_AGE_S=120

# ---- Optional: Redis (leave as-is; not required for Phase 1) ----
REDIS_URL=redis://localhost:6379/0

# ---- Exhaustion & context gates (24-Jul) ----
# Refuse cards whose invalidation sits closer than this many ATRs to spot.
SIGNAL_MIN_INVALIDATION_ATR=1.0
# Refuse cards when the future is stretched beyond this many ATRs from EMA20.
SIGNAL_MAX_EXTENSION_ATR=3.5
# Hold new cards this many seconds after a tick-feed gap ends.
SIGNAL_POST_GAP_QUIET_S=600
# Participation floors (25-Jul): a card whose Volume (of 15) or Options & OI
# (of 20) component scores below these is withheld — the other four components
# describe the chart, and a chart can look perfect on air (24-Jul: every big
# paper loser had volume 2-6/15 under a 25/25 price action). Vetoed cards are
# still paper-filled, tagged "hollow", so /paper/summary's hollow block shows
# whether the floor is earning its keep. 0 = off.
SIGNAL_MIN_VOLUME_SCORE=7
SIGNAL_MIN_OI_SCORE=8
# Intraday T1 from the paper book's MFE distribution (P75, clamped 8-27%,
# needs 30+ clean samples; static ladder until then). false = static only.
SIGNAL_T1_FROM_EXCURSIONS=true

# ---- Scalp mode (24-Jul) ----
# Enabled modes, comma-separated and in priority order. Add "scalp" to issue
# 1m-timeframe scalp cards (score gate 80, T1 +6%, 180s validity):
#   SIGNAL_MODES=intraday,scalp,positional
SIGNAL_MODES=intraday,positional
# Scalp cards are PAPER-ONLY: /trades/enter refuses them until this is true.
# Flip it only after the paper book holds 50+ honest scalp fills with positive
# net-of-charges expectancy — at scalp cadence the charges ARE the game.
SCALP_LIVE_ENABLED=false
# Refuse a scalp card when estimated round-trip charges exceed this fraction
# of the gross move to T1 at suggested size (0 disables the veto).
SCALP_MAX_FRICTION_PCT=0.20

# ---- Exit policy (25-Jul prototype) ----
# On a SINGLE-LOT trade, exit the whole position at the +12% quick target
# instead of going risk-free and trailing (1 lot cannot "book half", so the
# ratchet leaves the first +12% unbanked when a trade peaks near it and
# reverses). Default off: the paper summary's exit_ab block measures the
# paired counterfactual on every recorded fill — flip only when it shows
# banking ahead over 30+ diverged fills. NOTE: the A/B is only measurable
# while this is off; once banking is live the ratchet's path is unobservable.
QUICK_BANK_SINGLE_LOT=false
