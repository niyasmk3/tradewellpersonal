# ---- Kite Connect credentials ----
# From https://developers.kite.trade/apps (your active Connect app)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Access token is obtained daily via the login flow (POST /auth/session).
# It expires every morning (~7:30 AM IST), so you re-login each trading day.
# Once you have it you may paste it here to skip the browser step on restart.
KITE_ACCESS_TOKEN=

# ---- App config ----
# Underlyings to track in Phase 1 (comma-separated). Supported: NIFTY, BANKNIFTY, FINNIFTY
TRACK_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY

# How many strikes above/below ATM to build into the option chain
OPTION_CHAIN_DEPTH=10

# Option-chain refresh interval in seconds (Kite quote polling)
OPTION_POLL_SECONDS=5

# How often (seconds) the server broadcasts live state to browser clients
BROADCAST_SECONDS=1

# CORS origin for the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# ---- Phase 4: News intelligence (optional) ----
# Anthropic API key for Claude-powered news sentiment. Without it, news analysis
# is off and the news score stays neutral (everything else works).
ANTHROPIC_API_KEY=
# Model for classification. Opus is the default; claude-haiku-4-5 is cheaper for
# high-volume classification.
NEWS_MODEL=claude-opus-4-8
NEWS_ENABLED=true

# ---- Off-desk signal alerts (optional) ----
# The browser chime only fires with the dashboard tab open, so a signal issued
# while you are away is a signal you never see. Point this at a push endpoint and
# the backend posts each newly issued card to it. Empty = disabled, no network
# call is ever made.
#   ntfy:     https://ntfy.sh/pick-a-long-private-topic-name
#   Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat_id>
ALERT_WEBHOOK_URL=
# "text" posts a plain body (ntfy); "json" posts {title,text,message,score,...}
# which is what Telegram, Slack and Discord webhooks expect.
ALERT_WEBHOOK_FORMAT=text
# Only push cards at or above this score. 0 = every issued card (recommended:
# the throttle already caps the engine at 4 cards/day).
ALERT_MIN_SCORE=0

# ---- Position sizing (optional) ----
# Two different questions, two different knobs:
#   TRADING_CAPITAL — "how much may I LOSE per trade": drives the risk-based
#       suggested_lots via RISK_PER_TRADE_PCT. 0 = no suggestion shown.
#   TRADING_FUND    — "how many lots can my money BUY at this premium": the
#       day's deployable premium budget. Each card prefills
#       lots = fund ÷ (premium × lot size), so the Kite basket opens with the
#       right quantity. Editable live from the dashboard (risk-limits panel);
#       this value is only the baseline. 0 = feature off.
#       e.g. 1000000 at a ₹100 premium (lot 65) prefills 153 lots = 9,945 qty.
TRADING_CAPITAL=0
TRADING_FUND=0

# A signal card may only be issued on a premium quote at most this old
# (seconds). Protects against stale chain/tick prices publishing entry zones
# that no longer exist — observed lags ranged from 3 minutes to a full day.
# 0 disables the gate.
SIGNAL_MAX_PREMIUM_AGE_S=120

# ---- Optional: Redis (leave as-is; not required for Phase 1) ----
REDIS_URL=redis://localhost:6379/0
